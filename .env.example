# Required for Vercel. Create a libSQL-compatible Turso database, then copy its URL/token.
TURSO_DATABASE_URL=libsql://your-database-your-organization.turso.io
TURSO_AUTH_TOKEN=replace-with-your-database-token
# Optional: exact HTTPS origin of your custom/production domain, no path.
# APP_ORIGIN=https://daylog.example.com
# Without TURSO_* variables, localhost uses data/daylog.sqlite.
